<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#1C222B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- "THUMBNAIL" ESTILO SPOTIFY -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@android:color/darker_gray"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:layout_marginEnd="12dp" />

        <!-- INFO DE LA CANCIÓN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/textSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textSongArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textSongBpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BPM: 0"
                android:textColor="#81D4FA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- BOTONES LADO DERECHO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonPractice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Practicar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="#00897B"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/buttonOpenYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:backgroundTint="#455A64"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
